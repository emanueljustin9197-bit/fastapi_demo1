# MySQL 8 connection. URL-encode special characters in the password.
ASYNC_DATABASE_URL=mysql+aiomysql://root:replace_with_password@127.0.0.1:3306/online_form?charset=utf8mb4

# Replace this with a random string of at least 32 characters.
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# Public address used in generated questionnaire links and QR codes.
FRONTEND_BASE_URL=http://localhost:5173

# Optional AI features. Core questionnaire features work without AI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

SQLALCHEMY_ECHO=false
